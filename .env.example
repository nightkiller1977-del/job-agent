# Job Agent — environment configuration
# Copy to `.env` and fill in the SECRETS. `.env` is gitignored; never commit it.
# Non-secret settings below already match code defaults — override only if needed.

# ============================================================================
# SECRETS — you must fill these in (leave blank to disable that feature/source)
# ============================================================================

# --- LLM Inference Tiers (Ollama is tried first, then OpenRouter Gateway, Claude, OpenAI) ---
AICC_OPENROUTER_API_KEY=
OPENROUTER_GATEWAY_URL=http://127.0.0.1:3848
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# OpenRouter Task Model Overrides (optional defaults shown)
# JOB_AGENT_OPENROUTER_GENERAL_MODEL=anthropic/claude-3.5-haiku
# JOB_AGENT_OPENROUTER_REASONING_MODEL=anthropic/claude-3.5-sonnet
# JOB_AGENT_OPENROUTER_CODING_MODEL=qwen/qwen-2.5-coder-32b-instruct
# JOB_AGENT_OPENROUTER_MONITORING_MODEL=meta-llama/llama-3.3-70b-instruct

# --- Job source logins (needed for each source you use; blank = source skipped) ---
JOBRIGHT_EMAIL=
JOBRIGHT_PASSWORD=
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
INDEED_EMAIL=
INDEED_PASSWORD=
USAJOBS_EMAIL=
USAJOBS_PASSWORD=

# --- TheMuse (optional; public API works unauthenticated at 500 req/hr — register
# a free key at themuse.com/developers for 3600 req/hr) ---
THEMUSE_API_KEY=

# --- Company/portal ATS logins (for external application portals) ---
COMPANY_EMAIL=
COMPANY_PASSWORD=
COMPANY_EMAIL_ALT=
COMPANY_PASSWORD_ALT=

# --- Approval + notifications (optional) ---
APPROVAL_NOTIFY_EMAIL=
APPROVAL_SEND_EMAIL=
APPROVAL_SEND_PASSWORD=
IMAP_PASSWORD=
NOTIFY_PHONE=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Twilio (SMS approval), if used
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Cloud sync / dashboard (optional) ---
DASHBOARD_URL=
SYNC_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# --- Repair agent / GitHub (optional) ---
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=

# ============================================================================
# NON-SECRET CONFIG — defaults shown; override only if you need to
# ============================================================================

# Adapter go-live flag: 0 = proven legacy apply path (default), 1 = new adapter
# registry + Browser Use recovery + vendor adapters. Flip to 1 for live testing.
USE_ADAPTER_REGISTRY=0

# Reauth poll timeouts (minutes)
REAUTH_TIMEOUT_MINUTES=30
REAUTH_TIMEOUT_APPLY_MINUTES=10

# Local LLM (Ollama) — tried before cloud models
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT_SECONDS=120

# Commander / model overrides (defaults are sensible)
COMMANDER_ANTHROPIC_MODEL=claude-haiku-4-5
COMMANDER_OPENAI_MODEL=gpt-4o-mini

# Resume paths (optional; falls back to config.json / auto-discovery)
RESUME_PATH=
LOCAL_RESUME_PATH=

# Observability (optional)
LOKI_URL=
OTEL_EXPORTER_OTLP_ENDPOINT=
