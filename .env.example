ANTHROPIC_API_KEY=your_key_here

# Job site credentials for automated login
JOBRIGHT_EMAIL=your_jobright_email@example.com
JOBRIGHT_PASSWORD=your_jobright_password

LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password

USAJOBS_EMAIL=your_usajobs_email@example.com
USAJOBS_PASSWORD=your_usajobs_password

# Cloud dashboard (Render.com) — set after deploying
DASHBOARD_URL=https://your-app.onrender.com
SYNC_SECRET=your_sync_secret_here

# Self-healing auth — iMessage notifications when LinkedIn/USAJobs sessions expire
# Set to your iMessage-capable phone number (e.g. +13055551234)
NOTIFY_PHONE=

# How long to wait for human session refresh before skipping the source
REAUTH_TIMEOUT_MINUTES=30       # used during discover runs
REAUTH_TIMEOUT_APPLY_MINUTES=10 # shorter timeout during apply (avoids blocking other jobs)
