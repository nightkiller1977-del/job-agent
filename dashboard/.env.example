# MongoDB Atlas connection string (secret; configure in Render/aicc-secrets)
MONGODB_URI=
JOB_AGENT_DB=job_agent

# Existing dashboard sync/auth controls
SYNC_SECRET=
CREDENTIAL_ENCRYPTION_KEY=

# Optional: "Sign in with Google" as an alternative to typing SYNC_SECRET.
# Reuses an existing Google OAuth client (its redirect URIs must include
# <this dashboard's base URL>/auth/google/callback). All three must be set or
# the login page falls back to the sync-secret form only. ALLOWED_GOOGLE_EMAIL
# is the single account permitted to sign in this way.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_GOOGLE_EMAIL=
