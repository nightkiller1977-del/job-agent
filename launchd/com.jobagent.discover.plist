<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.jobagent.discover</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>cd __PROJECT_DIR__ &amp;&amp; .venv/bin/python3 src/main.py discover --no-review</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>SOPS_AGE_KEY_FILE</key>
        <string>__SOPS_AGE_KEY_FILE__</string>
        <key>AICC_SECRETS_DIR</key>
        <string>__AICC_SECRETS_DIR__</string>
    </dict>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__PROJECT_DIR__/state/discover.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_DIR__/state/discover.err</string>
</dict>
</plist>
