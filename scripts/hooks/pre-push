#!/usr/bin/env bash
# Runs tests before every push. Exit non-zero to abort the push.

set -uo pipefail

echo "==> pre-push: running Python test suite..."
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if [ -x "$REPO_ROOT/.venv/bin/pytest" ]; then
  PYTEST_PATH="$REPO_ROOT/.venv/bin/pytest"
else
  PRIMARY_WORKTREE="$(git worktree list --porcelain | awk '/^worktree / {sub(/^worktree /, ""); print; exit}')"
  if [ -n "$PRIMARY_WORKTREE" ] && [ -x "$PRIMARY_WORKTREE/.venv/bin/pytest" ]; then
    PYTEST_PATH="$PRIMARY_WORKTREE/.venv/bin/pytest"
  else
    PYTEST_PATH=""
  fi
fi

if [ -n "${PYTEST_PATH:-}" ]; then
  PYTEST=("$PYTEST_PATH")
else
  PYTEST=(python3 -m pytest)
fi

if "${PYTEST[@]}"; then
  echo "==> pre-push: all checks passed."
else
  status=$?
  branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
  "$REPO_ROOT/scripts/hooks/notify-push-blocked.sh" "Test suite failed on $branch — push aborted"
  exit "$status"
fi
